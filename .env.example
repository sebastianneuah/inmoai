# ── Pagos ────────────────────────────────────────────────────────────────
# Alias de Mercado Pago al que transfieren los clientes (se muestra en la confirmación)
ALIAS_MP=abraham.sushi.mp

# Número de WhatsApp del local, formato internacional sin "+" ni espacios.
# Recibe los comprobantes de transferencia y los avisos de pedidos si Fudo falla.
WHATSAPP_NUMERO=5491100000000

# ── Integración Fudo ─────────────────────────────────────────────────────
# "mock" hasta que Fudo habilite la API de inyección de pedidos y mande credenciales.
# Cuando lleguen: poner FUDO_MODE=live y completar las credenciales.
FUDO_MODE=mock
FUDO_CLIENT_ID=
FUDO_CLIENT_SECRET=
