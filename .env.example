# ── Base de datos (opcional pero recomendada) ────────────────────────────
# Postgres de Neon, Supabase o el que uses. Sin esto, la carta se sirve del
# snapshot data/catalogo.json y el panel admin queda en modo solo lectura.
DATABASE_URL=

# ── Panel administrativo ─────────────────────────────────────────────────
# Generá el hash y un secreto con: node scripts/generar-hash-admin.mjs "tu-contraseña"
ADMIN_USUARIO=abraham
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Lo agrega Vercel automáticamente al conectar un Blob store (fotos de productos)
BLOB_READ_WRITE_TOKEN=

# ── Pagos y contacto ─────────────────────────────────────────────────────
# Valores por defecto: una vez conectada la base se editan desde /admin
ALIAS_MP=abraham.sushi.mp
WHATSAPP_NUMERO=5491100000000

# ── Integración Fudo ─────────────────────────────────────────────────────
# "mock" hasta que Fudo habilite la API de inyección de pedidos.
FUDO_MODE=mock
FUDO_CLIENT_ID=
FUDO_CLIENT_SECRET=
